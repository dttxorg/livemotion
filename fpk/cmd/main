#!/bin/bash
FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"
is_docker_running () {
    local docker_name running
    [ -r "$FILE_PATH" ] || return 1
    docker_name=$(awk '$1 == "container_name:" { print $2; exit }' "$FILE_PATH")
    [ -n "$docker_name" ] || return 1
    running=$(docker inspect --format '{{.State.Running}}' "$docker_name" 2>/dev/null) || return 1
    [ "$running" = "true" ]
}
case $1 in
start) exit 0 ;;
stop) exit 0 ;;
status) if is_docker_running; then exit 0; else exit 3; fi ;;
*) exit 1 ;;
esac
