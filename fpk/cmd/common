#!/bin/bash

MKDIR="/bin/mkdir -p"
TEE="/usr/bin/tee -a"
TAR="/bin/tar"

if [ -z "${TRIM_PKGVAR:-}" ]; then
    echo "ERROR: TRIM_PKGVAR 未设置，无法确定数据存储路径" >&2
    exit 1
fi
case "${TRIM_PKGVAR}" in
    /vol*) ;;
    /usr/local/apps/@appdata/*) ;;
    *) echo "ERROR: TRIM_PKGVAR=${TRIM_PKGVAR} 不是有效的应用数据路径，拒绝继续" >&2; exit 1 ;;
esac
if ! mkdir -p "${TRIM_PKGVAR}"; then
    echo "ERROR: 创建应用数据目录失败: ${TRIM_PKGVAR}" >&2
    exit 1
fi

INST_ETC="/var/apps/${TRIM_APPNAME}/etc"
INST_VARIABLES="${INST_ETC}/installer-variables"
INST_LOG="/var/log/apps/${TRIM_APPNAME}.log"
FWPORTS_FILE="/var/apps/${TRIM_APPNAME}/etc/${TRIM_APPNAME}.sc"
SHARE_PATH="/var/apps/${TRIM_APPNAME}/shares/${TRIM_APPNAME}"
LOG_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.log"
PID_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.pid"
DNAME="${TRIM_APPNAME}"
DOCKER_NAME=""

error_exit() {
    local msg="$1"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "$msg" > "${TRIM_TEMP_LOGFILE}"
    fi
    echo "ERROR: $msg" >&2
    exit 1
}

install_log() {
    if [ "$#" -eq 0 ]; then
        while IFS= read -r line; do install_log "$line"; done
    else
        printf '%s\t%s\n' "$(date +'%Y/%m/%d %H:%M:%S')" "$*" >&2
    fi
}

call_func() {
    local func="${1:-}" log="${2:-}" result log_result
    local -a statuses
    if ! declare -F "${func}" >/dev/null; then
        return 0
    fi
    if [ -z "${log}" ]; then
        "${func}"
        return $?
    fi

    install_log "Begin ${func}" || return $?
    # The logger is the last pipeline command: preserve the hook's own status.
    if "${func}" 2>&1 | "${log}"; then
        statuses=("${PIPESTATUS[@]}")
    else
        statuses=("${PIPESTATUS[@]}")
    fi
    result="${statuses[0]}"
    if [ "${result}" -eq 0 ]; then
        result="${statuses[1]}"
    fi
    if install_log "End ${func} (status=${result})"; then
        :
    else
        log_result=$?
        if [ "${result}" -eq 0 ]; then result="${log_result}"; fi
    fi
    return "${result}"
}

load_variables_from_file() {
    if [ -n "$1" ] && [ -r "$1" ]; then
        while IFS= read -r line; do
            case "$line" in ''|'#'*) continue ;; esac
            key="$(echo "$line" | cut --fields=1 --delimiter==)"
            value="$(echo "$line" | cut --fields=2- --delimiter==)"
            export "${key}=${value}"
        done < "$1"
    fi
}

initialize_variables() { :; }
validate_preinst() { :; }
service_preinst() { :; }
service_postinst() { :; }
service_preuninst() { :; }
service_postuninst() { :; }
validate_preupgrade() { :; }
service_preupgrade() { :; }
service_save() { :; }
service_restore() { :; }
service_postupgrade() { :; }
service_preconfig() { :; }
service_postconfig() { :; }

log_step() {
    install_log "===> Step $1. STATUS=${TRIM_APP_STATUS:-} USER=${USER:-} GROUP=${GROUP:-} SHARE_PATH=${SHARE_PATH:-}"
}

stop_daemon() { :; }

daemon_status() {
    local file_path="${TRIM_APPDEST}/docker/docker-compose.yaml" docker_name running
    [ -r "$file_path" ] || return 1
    docker_name=$(awk '$1 == "container_name:" { print $2; exit }' "$file_path")
    [ -n "$docker_name" ] || return 1
    running=$(docker inspect --format '{{.State.Running}}' "$docker_name" 2>/dev/null) || return 1
    [ "$running" = "true" ]
}

install_init() {
    log_step "install_init"
    call_func "validate_preinst" install_log || return $?
    call_func "service_preinst" install_log
}

install_callback() {
    log_step "install_callback"
    call_func "service_postinst" install_log
}

uninstall_init() {
    log_step "uninstall_init"
    stop_daemon || return $?
    call_func "service_preuninst" install_log
}

uninstall_callback() {
    log_step "uninstall_callback"
    call_func "service_postuninst" install_log
}

upgrade_init() {
    log_step "upgrade_init"
    call_func "validate_preupgrade" install_log || return $?
    stop_daemon || return $?
    call_func "service_preupgrade" install_log || return $?
    call_func "service_save" install_log
}

upgrade_callback() {
    log_step "upgrade_callback"
    call_func "service_restore" install_log || return $?
    call_func "service_postupgrade" install_log
}

config_init() {
    log_step "config_init"
    call_func "service_preconfig" install_log
}

config_callback() {
    log_step "config_callback"
    call_func "service_postconfig" install_log
}
