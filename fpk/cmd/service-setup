#!/bin/bash

PHOTOS_DIR="/vol2/photos"
CONFIG_DIR="/vol1/docker/livephoto-worker/config"
DEFAULT_CONFIG="${CONFIG_DIR}/config.json"

create_livemotion_defaults() {
    local directory relative volume temporary_config
    for directory in "$PHOTOS_DIR" "$CONFIG_DIR"; do
        case "$directory" in
            /vol[0-9]*/*)
                relative="${directory#/}"
                volume="/${relative%%/*}"
                if [ ! -d "$volume" ]; then
                    install_log "Storage volume is missing: $volume"
                    return 1
                fi
                ;;
        esac
    done
    mkdir -p "${PHOTOS_DIR}/live_inbox" "${PHOTOS_DIR}/motion_output" "${PHOTOS_DIR}/archive" "${PHOTOS_DIR}/failed" || return $?
    mkdir -p "${CONFIG_DIR}" || return $?
    if [ -f "$DEFAULT_CONFIG" ]; then
        return 0
    fi
    if [ -e "$DEFAULT_CONFIG" ] || [ -L "$DEFAULT_CONFIG" ]; then
        install_log "Configuration path is not a regular file: $DEFAULT_CONFIG"
        return 1
    fi
    temporary_config=$(mktemp "${CONFIG_DIR}/.config.json.XXXXXX") || return $?
    if cat > "$temporary_config" <<'JSON'
{
  "input_dir": "/photos/live_inbox",
  "output_dir": "/photos/motion_output",
  "archive_dir": "/photos/archive",
  "failed_dir": "/photos/failed",
  "stable_seconds": 30,
  "poll_interval": 10,
  "move_originals": true,
  "enable_archive": true
}
JSON
    then
        :
    else
        local result=$?
        rm -f "$temporary_config"
        return "$result"
    fi
    if mv "$temporary_config" "$DEFAULT_CONFIG"; then
        return 0
    else
        local result=$?
        rm -f "$temporary_config"
        return "$result"
    fi
}

validate_preinst() {
    if ! command -v docker >/dev/null 2>&1; then
        error_exit "未检测到 Docker。LiveMotion FPK 需要 fnOS Docker 支持。"
    fi
}

service_postinst() {
    create_livemotion_defaults
}

service_postupgrade() {
    create_livemotion_defaults
}

service_postconfig() {
    create_livemotion_defaults
}
